<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CFDI issuance notification</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f4f6f8; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f4f6f8; padding: 24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 8px;">
            <tr>
              <td style="padding: 32px 32px 16px 32px;">
                <h1 style="margin: 0; font-size: 20px; color: #111827;">Your digital tax receipt (CFDI) is ready</h1>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 32px 16px 32px;">
                <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.5;">
                  {{#if recipientName}}Dear {{recipientName}}{{else}}Dear customer{{/if}},
                </p>
                <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.5;">
                  Thank you for your recent purchase{{#if issuerName}} with {{issuerName}}{{/if}}. We confirm that your payment has been processed successfully and that the corresponding Comprobante Fiscal Digital por Internet (CFDI) has been issued.
                </p>
                <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.5;">
                  Attached to this email you will find the <strong>XML</strong> and <strong>PDF</strong> versions of the CFDI for your records and download.
                </p>
              </td>
            </tr>

            {{#if folio}}
              <tr>
                <td style="padding: 0 32px 12px 32px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px;">
                    <tr>
                      <td style="padding: 16px;">
                        <p style="margin: 0; font-size: 13px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;">Folio</p>
                        <p style="margin: 4px 0 0 0; font-size: 15px; color: #111827; font-weight: bold;">{{folio}}</p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            {{/if}}

            {{#if uuid}}
              <tr>
                <td style="padding: 0 32px 12px 32px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px;">
                    <tr>
                      <td style="padding: 16px;">
                        <p style="margin: 0; font-size: 13px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;">CFDI UUID</p>
                        <p style="margin: 4px 0 0 0; font-size: 13px; color: #111827; word-break: break-all;">{{uuid}}</p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            {{/if}}

            {{#if issueDate}}
              <tr>
                <td style="padding: 0 32px 12px 32px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px;">
                    <tr>
                      <td style="padding: 16px;">
                        <p style="margin: 0; font-size: 13px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;">Issue date</p>
                        <p style="margin: 4px 0 0 0; font-size: 15px; color: #111827;">{{issueDate}}</p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            {{/if}}

            {{#if total}}
              <tr>
                <td style="padding: 0 32px 16px 32px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px;">
                    <tr>
                      <td style="padding: 16px;">
                        <p style="margin: 0; font-size: 13px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;">Total</p>
                        <p style="margin: 4px 0 0 0; font-size: 15px; color: #111827; font-weight: bold;">{{total}}{{#if currency}} {{currency}}{{/if}}</p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            {{/if}}

            <tr>
              <td style="padding: 8px 32px 24px 32px;">
                <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.5;">
                  We recommend keeping these files as part of your accounting records and presenting them whenever required by the corresponding tax authority.
                </p>
                {{#if supportEmail}}
                  <p style="margin: 0; font-size: 15px; line-height: 1.5;">
                    If you have any questions or do not receive the attachments, please reach us at <a href="mailto:{{supportEmail}}" style="color: #2563eb; text-decoration: none;">{{supportEmail}}</a> and we will be glad to help.
                  </p>
                {{/if}}
              </td>
            </tr>

            <tr>
              <td style="padding: 16px 32px 32px 32px; border-top: 1px solid #e5e7eb;">
                <p style="margin: 0; font-size: 13px; color: #6b7280; line-height: 1.5;">
                  This message is automatically generated as a result of your CFDI issuance{{#if issuerName}} by {{issuerName}}{{/if}}.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>